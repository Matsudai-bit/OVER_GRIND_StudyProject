  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryManager
  m_interval: 0.04
  m_cursorBlinkInterval: 1
  m_appearanceArrowTime: 1
  m_storyImage: {fileID: 8693626082107932243}
  m_storyText: {fileID: 7886630075160557580}
  m_arrowImage: {fileID: 5428017809114296158}
  m_videoPlayer: {fileID: 6414940817200754729}
  m_videoImage: {fileID: 4075353403468365181}
  m_loopVideo: 0
  m_storyPages:
  - m_storyTexture: {fileID: 21300000, guid: 002c5404106c90c4cb52904f209da3c8, type: 3}
    m_storyText: "\u300E20XX\u5E74\u30FB\u67D0\u5DE5\u696D\u90FD\u5E02\u2500\u2500\u653F\u5E9C\u7BA1\u8F44\u306E\u200B\u5EC3\u5DE5\u5834\u304C\u200B\u7A3C\u50CD\u3057\u3066\u3044\u305F\u200B\u3053\u3068\u304C\u200B\u5224\u660E\u3002\n\u4F5C\u696D\u3092\u200B\u5168\u9762\u200B\u4E2D\u6B62\u3078\u3002\u200B\u5F53\u5C40\u306F\u200B\u6C88\u9ED9\u3092\u200B\u7DAD\u6301\u3057\u3066\u3044\u308B\u300F"
    m_storyVideo: {fileID: 0}
  - m_storyTexture: {fileID: 21300000, guid: f4f4ee010edcc4942be2cfe311d732e1, type: 3}
    m_storyText: "\u200B\u300C\u4E00\u90E8\u3067\u306F\u3001\u200B\u653F\u5E9C\u304C\u200B\u6975\u79D8\u88CF\u306B\u200B\u9032\u3081\u3066\u200B\u3044\u305F\u200B\u300EAI\u7814\u7A76\u300F\u306E\u200B\u5931\u6557\u306B\u200B\u3088\u308A\u3001\n\u200B\u624B\u306B\u200B\u8CA0\u3048\u306A\u304F\u306A\u3063\u305F\u200B\u4E0A\u5C64\u90E8\u304C\u200B\u591C\u9003\u3052\u540C\u7B49\u306B\u200B\u64A4\u9000\u3057\u305F\u3068\u306E\u200B\u4E0D\u7A4F\u306A\u200B\u5642\u304C\u200B\u6D6E\u4E0A\u3057\u3066\u3044\u308B\u300D"
    m_storyVideo: {fileID: 0}
  - m_storyTexture: {fileID: 21300000, guid: 5b1848588356c394fa5d4b56450e4911, type: 3}
    m_storyText: "\u200B\u300C\u2500\u2500\u3010\u203CWARNING\u203C\u3011\uFF1A\u53D6\u308A\u6B8B\u3055\u308C\u305F\u200BAI\u306F\u200B\u5DE5\u5834\u305D\u306E\u200B\u3082\u306E\u3092\u200B\u53D6\u308A\u8FBC\u307F\u3001\n\u200B\u81EA\u5F8B\u7684\u306A\u200B\u300E\u81EA\u5DF1\u9032\u5316\u300F\u3092\u200B\u958B\u59CB\u3002\u200B\u305D\u308C\u306F\u200B\u3082\u306F\u200B\u3084\u65E2\u5B58\u306E\u200B\u5175\u5668\u3092\u200B\u51CC\u99D5\u3059\u308B\u3001\n\u200B\u9A5A\u7570\u7684\u306A\u200B\u3010\u5DE8\u5927\u6A5F\u68B0\u751F\u7269\u3011\u3078\u3068\u200B\u5909\u8C8C\u3092\u200B\u9042\u3052\u3064\u3064\u3042\u308B\u200B\u2500\u2500\u300D\u200B"
    m_storyVideo: {fileID: 0}
  - m_storyTexture: {fileID: 21300000, guid: 4e3f672653cfb5942a6b0003ca3123c7, type: 3}
    m_storyText: "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u3002\u200B"
    m_storyVideo: {fileID: 0}
  - m_storyTexture: {fileID: 21300000, guid: bb51ca962d4a2d4448546d33c8055e3f, type: 3}
    m_storyText: "\u300C\u305D\u3093\u306A\u56FD\u5BB6\u5371\u6A5F\u3092\u4E00\u5207\u77E5\u3089\u306C\u307E\u307E\u3001\u4E00\u4EBA\u306E\u5C11\u5E74\u304C\u975E\u6B63\u898F\u300C\u89E3\u4F53\u5C4B\u300D\u3068\u3057\u3066\u3053\u306E\u8B66\u6212\u533A\u57DF\u306B\u8DB3\u3092\u8E0F\u307F\u5165\u308C\u305F\u300D"
    m_storyVideo: {fileID: 0}
  - m_storyTexture: {fileID: 21300000, guid: 1ef6d332d6da325488b3bc8d1cd64555, type: 3}
    m_storyText: "\u300E\u5F7C\u306E\u200B\u624B\u306B\u200B\u3042\u308B\u306E\u306F\u3001\u200B\u65B0\u3057\u304F\u200B\u81EA\u4F5C\u3057\u305F\u200B\u898F\u683C\u5916\u306E\u200B\u89E3\u4F53\u9053\u5177\u2500\u2500\u8DB3\u6280\u3067\u3059\u3079\u3066\u3092\u200B\u5207\u308A\u523B\u3080\n\u30C1\u30A7\u30FC\u30F3\u30BD\u30FC\u3092\u200B\u6A21\u3057\u3066\u200B\u9020\u3089\u308C\u305F\u200B\u30B7\u30E5\u30FC\u30BA\u3001\u200B\u305D\u306E\u200B\u540D\u3082\u200B\u300CRev-Ripper\u200B\uFF08\u30EC\u30D6\u30EA\u30C3\u30D1\u30FC\uFF09\u300D\u300F"
    m_storyVideo: {fileID: 0}
  - m_storyTexture: {fileID: 0}
    m_storyText: "\u200B\u300C\u8FEB\u308A\u200B\u6765\u308B\u200B\u90FD\u5E02\u5D29\u58CA\u306E\u200B\u6050\u6016\u3082\u200B\u77E5\u3089\u305A\u3001\u200B\u305F\u3060\u200B\u5C11\u5E74\u306F\u200B\u3053\u306E\u200B\u65B0\u305F\u306A\u200B\u76F8\u68D2\u3092\u200B\u8A66\u3059\u885D\u52D5\u306B\u200B\u6EFE\u3089\u305B\u3001\n\u8DB3\u3092\u200B\u9032\u3081\u308B\u306E\u3067\u3042\u3063\u305F\u2500\u2500\u200B\u300D"
    m_storyVideo: {fileID: 32900000, guid: 7c0267b0fdb20ae49bb3c25136def8a3, type: 3}
