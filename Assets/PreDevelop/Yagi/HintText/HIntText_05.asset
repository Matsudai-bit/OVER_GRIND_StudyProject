  m_body: "\u30EC\u30FC\u30EB\u304B\u3089\u98DB\u3073\u51FA\u3057\u3066\u653B\u6483\u3092\u3059\u308B\r\n\u30EC\u30FC\u30EB\u304B\u3089\u30B8\u30E3\u30F3\u30D7\u3057\u305F\u6642\u3082\u53EF\u80FD\r\n\u901A\u5E38\u306E\u30B8\u30E3\u30F3\u30D7\u304B\u3089\u306F\u767A\u751F\u3057\u306A\u3044"
